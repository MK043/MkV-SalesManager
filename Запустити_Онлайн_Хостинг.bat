@echo off
chcp 65001 > nul
title MKV Автосервіс - Онлайн Хостинг
echo ========================================================
echo       MKV АВТОСЕРВІС - ЗАПУСК ОНЛАЙН ХОСТИНГУ
echo ========================================================
echo Запуск локального бекенду та онлайн тунелю Cloudflare...
echo.
cd /d "%~dp0"
start "MKV Server" /min node server/index.js
timeout /t 2 /nobreak > nul
echo.
echo ========================================================
echo Онлайн доступ відкривається... Посилання буде вказано нижче:
echo ========================================================
echo.
bin\cloudflared.exe tunnel --url http://127.0.0.1:3001
pause
